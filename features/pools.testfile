launch :rpc, "bundle exec anyt --only-rpc"
wait_tcp 50051

launch :anycable, "./dist/anycable-go --netpoll_enabled=true --write_gopool_size=1 --read_gopool_size=1 --read_queue_timeout=1000 --metrics_rotate_interval=1 --rpc_concurrency=1 --rpc_request_timeout=5000 --metrics_log --metrics_log_filter=rpc_call_total,rpc_error_total,poll_pool_timeouts_total,read_pool_pending_num,read_pool_running_num,poll_pool_pending_num,poll_pool_running_num --disable_disconnect",
  capture_output: true
wait_tcp 8080

scenario = [
  {
    client: {
      protocol: "action_cable",
      multiplier: ":scale",
      name: "first",
      actions: [
        {
          subscribe: {
            channel: "BenchmarkChannel"
          }
        },
        "wait_all",
        {
          perform: {
            channel: "BenchmarkChannel",
            action: "echo",
            data: {
              message: "hello",
              delay: 2
            }
          }
        },
        {
          sleep: {
            time: 6
          }
        },
        {
          receive: {
            channel: "BenchmarkChannel",
            action: "echo",
            data: {
              message: "hello",
              delay: 2
            }
          }
        }
      ]
    }
  },
  {
    client: {
      protocol: "action_cable",
      name: "looser",
      actions: [
        {
          subscribe: {
            channel: "BenchmarkChannel"
          }
        },
        "wait_all",
        {
          sleep: {
            time: 0.1
          }
        },
        {
          perform: {
            channel: "BenchmarkChannel",
            action: "echo",
            data: {
              message: "hello",
              delay: 5
            }
          }
        },
        {
          sleep: {
            time: 5
          }
        },
        {
          receive: {
            channel: "BenchmarkChannel",
            action: "echo",
            data: {
              message: "hello",
              delay: 5
            }
          }
        }
      ]
    }
  }
]

TEST_COMMAND = <<~CMD
  bundle exec wsdirector ws://localhost:8080/cable -i #{scenario.to_json} -s 4
CMD

run :wsdirector, TEST_COMMAND

result = stdout(:wsdirector)

unless result.include?("Group first: 4 clients, 0 failures")
  stop :anycable
  fail "[Run #1] Unexpected scenario result:\n#{result}\n#{stdout(:anycable)}"
end

# Wait for metrics to be logged
sleep 1

run :wsdirector, TEST_COMMAND

result = stdout(:wsdirector)

unless result.include?("Group first: 4 clients, 0 failures")
  stop :anycable
  fail "[Run #2] Unexpected scenario result:\n#{result}\n#{stdout(:anycable)}"
end

sleep 3

stop :anycable

logs = stdout(:anycable)

# Scan logs for rpc_call_total and poll_pool_timeouts_total metrics
rpc_call_total = 0
rpc_error_total = 0
poll_pool_timeouts_total = 0

logs.each_line do |line|
  if line =~ /rpc_call_total=(\d+)/
    rpc_call_total += $1.to_i
  end
  if line =~ /rpc_error_total=(\d+)/
    rpc_error_total += $1.to_i
  end
  if line =~ /poll_pool_timeouts_total=(\d+)/
    poll_pool_timeouts_total += $1.to_i
  end
end

fail "Unexpected poll_pool_timeouts_total: #{poll_pool_timeouts_total} (rpc_call_total=#{rpc_call_total} rpc_error_total=#{rpc_error_total})\n\n#{logs}" if poll_pool_timeouts_total != 2
